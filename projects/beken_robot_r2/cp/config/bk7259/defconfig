#
# Automatically generated project default config. You can update it with menuconfig [D] option.
# This file contains only differences compared to board defconfig.
#
CONFIG_BT=y
CONFIG_BTDM_CONTROLLER_ONLY=y
CONFIG_GET_UID_ENABLE=y
CONFIG_DUMP_BY_LOG_UART=y
CONFIG_OTP_V1=y
CONFIG_USR_GPIO_CFG_EN=y

# AP logs are forwarded to CP through mailbox.  CP owns the physical log UART
# connected to the Type-C CH340 (P11 TX / P10 RX).
CONFIG_UART_PRINT_PORT=0
CONFIG_PSRAM_AS_SYS_MEMORY=n
CONFIG_OVERRIDE_VND_CAL=y
CONFIG_CPU_DEFAULT_FREQ_60M=n
CONFIG_KEEP_ALIVE_ARP_REPLY_ENABLE=y