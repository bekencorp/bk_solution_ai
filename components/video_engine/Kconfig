# KCONFIG_GROUP: Solution & Product
menu "video_engine"

	config BK_VIDEO_ENGINE
	bool "enable video engine"
	default y
		
	choice VIDEO_ENGINE_USE_CAMERA_TYPE
		prompt "Select video engine use camera type"
		default VIDEO_ENGINE_USE_DVP_CAMERA

		config VIDEO_ENGINE_USE_DVP_CAMERA
		bool "Select DVP camera"
		help
			Select DVP camera

		config VIDEO_ENGINE_USE_MIPI_CAMERA
		bool "Select MIPI CSI camera"
		depends on ISP && MIPI_CSI && CSI_CAMERA
		help
			Select BK7259 MIPI CSI camera through ISP and H.264 encoder.

		config VIDEO_ENGINE_USE_UVC_CAMERA
		bool "Select UVC camera"
		help
			Select UVC camera
	endchoice

	choice VIDEO_ENGINE_IMAGE_FORMAT
		prompt "Select video engine image format"
		default VIDEO_ENGINE_JPEG_FORMAT

		config VIDEO_ENGINE_JPEG_FORMAT
		bool "Select JPEG image format"
		help
			Select JPEG image format

		config VIDEO_ENGINE_H264_FORMAT
		bool "Select H264 image format"
		help
			Select H264 image format
	endchoice

	config VIDEO_ENGINE_RESOLUTION_WIDTH
	int "Default size of the width"
	range 1 2000
	default 1280
	help
		Set the size of the resolution width, The recommended value is 1280 .

	config VIDEO_ENGINE_RESOLUTION_HEIGHT
	int "Default size of the height"
	range 1 2000
	default 720
	help
		Set the size of the resolution height, The recommended value is 720 .

	config VIDEO_ENGINE_MIPI_SENSOR_WIDTH
	int "MIPI sensor width"
	depends on VIDEO_ENGINE_USE_MIPI_CAMERA
	range 1 2000
	default 1280
	help
		Set the MIPI sensor input width.

	config VIDEO_ENGINE_MIPI_SENSOR_HEIGHT
	int "MIPI sensor height"
	depends on VIDEO_ENGINE_USE_MIPI_CAMERA
	range 1 2000
	default 720
	help
		Set the MIPI sensor input height.

	config VIDEO_ENGINE_MIPI_SENSOR_FPS
	int "MIPI sensor FPS"
	depends on VIDEO_ENGINE_USE_MIPI_CAMERA
	range 1 120
	default 25
	help
		Set the MIPI sensor input frame rate.

endmenu
