menu "LVGL BAF Example Configuration"

choice
    prompt "BAF example playback backend"
    default BAF_EXAMPLE_MODE_RAW
    help
      Select how the BAF animation is played and shown. RAW drives the closed
      bk_baf decoder + GPU compositor directly and flushes straight to the DPU
      panel (no LVGL). LVGL renders through the lv_baf widget.

config BAF_EXAMPLE_MODE_RAW
    bool "Raw bk_baf (no LVGL): decode + GPU compose + direct DPU flush"

config BAF_EXAMPLE_MODE_LVGL
    bool "lv_baf LVGL widget"
    select LVGL

endchoice

choice
    prompt "BAF RAW render backend"
    depends on BAF_EXAMPLE_MODE_RAW
    default BAF_RAW_RENDER_GPU
    help
      Compositor used by the RAW backend. GPU uses VG-Lite (bk_baf_open brings
      it up in the library); CPU uses Helium/MVE with no GPU init. In LVGL mode the
      backend is chosen automatically from whether LVGL initialised the GPU.

config BAF_RAW_RENDER_GPU
    bool "GPU (VG-Lite)"

config BAF_RAW_RENDER_CPU
    bool "CPU (Helium)"

endchoice

endmenu
