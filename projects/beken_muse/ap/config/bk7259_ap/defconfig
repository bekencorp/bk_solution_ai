# LVGL dynamic memory (widget tree, and crucially the transform_zoom
# intermediate layers for the 2x voice-reply overlay, several hundred KB)
# must come from PSRAM: the SRAM heap cannot satisfy a layer alloc, the
# malloc returns NULL and lv_draw_sw_blend_* writes to address 0
# (MemFault, MMFAR=0x0, 2026-10-29).
CONFIG_LVGL_MEM_USE_PSRAM=y
CONFIG_LVGL_TASK_PRIORITY=4
CONFIG_LVGL_TASK_STACK_SIZE=8192
CONFIG_LVGL_FRAME_BUFFER_NUM=2
CONFIG_LWIP_PPP_SUPPORT=y
# Voice uplink throughput: 16bit/16k PCM as base64 needs ~42KB/s but the
# vendor 21900-byte TCP window tops out at ~25KB/s, so recordings backlog
# and replies arrive late. 32850 measured 25->80KB/s. Must stay below
# LWIP_MEM_MAX_TX_SIZE (42666); QUEUELEN >= 2*SND_BUF/MSS (=45), and
# MEMP_NUM_TCP_SEG >= 2*QUEUELEN per the lwip Kconfig help.
CONFIG_LWIP_TCP_SND_BUF=32850
CONFIG_LWIP_TCP_WND=32850
CONFIG_LWIP_TCP_SND_QUEUELEN=48
CONFIG_LWIP_MEMP_NUM_TCP_SEG=96
# A send poll timeout is transient TX congestion, not a dead link: fail the
# send only and let the volc ASR/TTS clients retry instead of losing the
# whole voice turn on a ~1 s WiFi stall (field 2026-11-12). SDK default n
# keeps every other solution's behaviour byte-identical.
CONFIG_WEBSOCKET_KEEP_CONN_ON_SEND_TIMEOUT=y
