menu "BEKEN GENIE demo Configuration"
    config LDO3V3_ENABLE
        bool "Enabel LDO_3V3"
        default n

    config HARDWARE_SPEAKER_VER
        int "select HARDWARE_SPEAKER_VER"
        range 0 8
        default 0

    config ROBOT_TEST
        bool "Enable ROBOT_TEST (beken_generated page nav custom code)"
        default y
        help
            When enabled, the build defines ROBOT_TEST=1 so that #if ROBOT_TEST blocks
            in page_N_init.c (navigation hooks, ui_nav_register_screen, etc.) are compiled.
            Disable only if you need a build without that custom code.
endmenu
