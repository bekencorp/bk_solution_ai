#
# secureboot_headset_lp AP defconfig
#

# platform
CONFIG_SOC_SMP=y
CONFIG_CPU_ID_OFFSET=2
CONFIG_SMP_CORE_CNT=2
# CONFIG_FREERTOS_V10 is not set
CONFIG_FREERTOS_SMP=y
CONFIG_SPE=0
CONFIG_SRAM_DIRECT_ADDR=y
CONFIG_SLAVE_HEART_BEAT=n
CONFIG_SUPPORT_WWDT=y
# CONFIG_SYSTICK_32K is not set
CONFIG_SPINLOCK_DYNAMIC_CNT=512
CONFIG_GENERAL_DMA=y
CONFIG_GENERAL_DMA_V2P6=y
CONFIG_DMA_LOGIC_CHAN_CNT=4
CONFIG_DMA_LOGIC_CHAN_ID_MIN=4
# L2 cache off: keep NS AP away from the PL310 window (Secure Shim probes it)
# CONFIG_L2_CACHE_ENABLE is not set
# SPI unused on this board (TP is I2C, LCD is MIPI)
# CONFIG_SPI is not set
# CONFIG_SPI_DMA is not set

# robot hardware
CONFIG_ADC_KEY=y
CONFIG_ROBOT_V2_ADC_KEYS=y
CONFIG_ROBOT_KEY1_ADC_GPIO=13
CONFIG_ROBOT_KEY1_ADC_CHAN=15
CONFIG_ROBOT_KEY2_ADC_GPIO=28
CONFIG_ROBOT_KEY2_ADC_CHAN=4
CONFIG_ROBOT_KEY_S2_VOLTAGE_LOW=500
CONFIG_ROBOT_KEY_S2_VOLTAGE_HIGH=1500
CONFIG_ROBOT_KEY_S3_VOLTAGE_LOW=4500
CONFIG_ROBOT_KEY_S3_VOLTAGE_HIGH=6000
CONFIG_ROBOT_KEY_S4_VOLTAGE_LOW=500
CONFIG_ROBOT_KEY_S4_VOLTAGE_HIGH=1500
CONFIG_ROBOT_KEY_S5_VOLTAGE_LOW=4500
CONFIG_ROBOT_KEY_S5_VOLTAGE_HIGH=6000
CONFIG_ADC_KEY_LONG_PRESS_MS=3000

# bluetooth
CONFIG_BLUETOOTH_HOST_ONLY=y
CONFIG_BLUETOOTH_AP=y
CONFIG_BT=y
CONFIG_BLUETOOTH_BTDM_COMPONENT_ENABLE=y
CONFIG_HFP_HF_DEMO=y
CONFIG_BLUETOOTH_BTDM_COMPONENT_BLE_GATT=y
CONFIG_BLUETOOTH_BTDM_COMPONENT_BLE_GATTS_TEST_ATTR=n
CONFIG_BLUETOOTH_BTDM_COMPONENT_BLE_HOGPD=n

# audio
CONFIG_AUDIO=y
CONFIG_AUD_DRIVER_V2=y
CONFIG_AUDIO_ADC=y
CONFIG_AUDIO_DAC=y
CONFIG_AUDIO_PLAY=y
CONFIG_AUDIO_RECORD=y
CONFIG_ADK=y
CONFIG_ADK_USE_PSRAM=y
CONFIG_ADK_EQ_ALGORITHM=y
CONFIG_ADK_MIX_ALGORITHM=y
CONFIG_ADK_ONBOARD_MIC_STREAM=y
CONFIG_ADK_ONBOARD_MIC_STREAM_V2=y
CONFIG_ADK_ONBOARD_SPEAKER_STREAM=y
CONFIG_ADK_ONBOARD_SPEAKER_STREAM_SUPPORT_MULTIPLE_SOURCE=y
CONFIG_ADK_ONBOARD_SPEAKER_STREAM_V2=y
CONFIG_ADK_RAW_STREAM=y
CONFIG_ADK_SBC_DECODER=y
CONFIG_ADK_SBC_ENCODER=y
CONFIG_ADK_AAC_DECODER=y
CONFIG_ADK_VFS_STREAM=y
CONFIG_PLAYER_SERVICE=y
CONFIG_PLAYER_SERVICE_SUPPORT_ARRAY_STREAM=y
CONFIG_PLAYER_SERVICE_SUPPORT_VFS_STREAM=y
CONFIG_PLAYER_SERVICE_SUPPORT_MP3_DECODER=y
CONFIG_PLAYER_SERVICE_SUPPORT_WAV_DECODER=y

# PM
CONFIG_CPU_DEFAULT_FREQ_60M=n
CONFIG_FREERTOS_USE_TICKLESS_IDLE=2
CONFIG_GPIO_WAKEUP_SUPPORT=y
CONFIG_GPIO_DYNAMIC_WAKEUP_SUPPORT=y
CONFIG_PM_AP_SUBPOWER_DOMAIN_DEFAULT_DISABLE=y
CONFIG_PM_AP_CPU_FRQ_DEFAUL=y
CONFIG_PSRAM_DATA_RETENTION_ENABLE=y
CONFIG_PM_AP_FAST_BOOT_ENABLE=y
CONFIG_BLUETOOTH_SUPPORT_AP_PWD_RETENTION=y

# display
CONFIG_BK_DISPLAY=y
CONFIG_BK_PERIPHERAL=y
# app_display MIPI panel + DPU helpers; H264 encode off (no camera on headset)
CONFIG_MULTIMEDIA_DEVICE_SERVICE=y
# CONFIG_MULTIMEDIA_H264_ENCODE is not set
CONFIG_DSI_DRIVER=y
CONFIG_DPU_DRIVER=y
CONFIG_MIPI_DSI=y
CONFIG_FRAME_BUFFER=y
CONFIG_VG_LITE_GPU=y
# NS address = Secure base 0x4c280000 + SOC_ADDR_OFFSET(0x10000000)
CONFIG_VG_LITE_GPU_BASE_ADDRESS=0x5c280000
CONFIG_VG_LITE_GPU_COMMAND_BUFFER_SIZE=0x2000
CONFIG_VG_LITE_GPU_TESS_WIDTH=200
CONFIG_VG_LITE_GPU_TESS_HEIGHT=160
CONFIG_LCD_DSI=y
CONFIG_LCD_JD9855_MIPI_320x385=y
CONFIG_TP=y
CONFIG_TP_CST9217=y
CONFIG_TP_RST_PIN=29
CONFIG_TP_INT_PIN=30
CONFIG_TP_I2C_SDA_PIN=71
CONFIG_TP_I2C_SCL_PIN=70
CONFIG_LVGL=y
CONFIG_LVGL_V9=y
CONFIG_LVGL_TASK_PRIORITY=4
CONFIG_LVGL_TASK_STACK_SIZE=8192
CONFIG_LVGL_FRAME_BUFFER_NUM=2

# system
CONFIG_FREERTOS_USE_QUEUE_SETS=y
CONFIG_FREERTOS_POSIX=y
CONFIG_GET_UID_ENABLE=y
CONFIG_VFS=y
CONFIG_EASY_FLASH_V4=y
CONFIG_CJSON_USE=y
CONFIG_LITTLEFS=y
CONFIG_LITTLEFS_NO_CONFIG_PARTITION=y
CONFIG_MEDIA_SERVICE=y
CONFIG_MEMDUMP_ALL=y
CONFIG_DUMP_UART_MEM_ENCODING_ASCII=y
CONFIG_DUMP_BY_LOG_UART=y
CONFIG_LOG_TASK_STACK_SIZE=2048
CONFIG_TASK_WDT=n
CONFIG_AT=y
CONFIG_DEFAULT_AT_PORT=5

# peripheral
CONFIG_UART_ERR_INTERRUPT=y
CONFIG_UART2_TX_PIN=69
CONFIG_UART5=y
CONFIG_UART5_TX_PIN=65
CONFIG_UART5_RX_PIN=64
CONFIG_PWM=y
CONFIG_USR_GPIO_CFG_EN=y

# storage
# Not used: the product only does BT audio + UI, there is no SD card, no SD-NAND
# and no USB mass-storage path. Keeping them off also stops the SDIO host/card
# from drawing current while the system is idle.
# CONFIG_SDCARD is not set
# CONFIG_FATFS is not set
# CONFIG_FATFS_SDCARD is not set
# CONFIG_SDCARD_HOST_ID is not set
# CONFIG_SDCARD_BUSWIDTH_4LINE is not set
# CONFIG_BOARD_SD_NAND_ENABLE is not set
# CONFIG_BOARD_SD_NAND_POWER_GPIO is not set
# CONFIG_BOARD_USB_SWITCH_ENABLE is not set
# CONFIG_BOARD_USB_SWITCH_GPIO is not set
# CONFIG_VFS_TEST is not set
# CONFIG_USB_DEVICE is not set
# CONFIG_USBD_MSC is not set
CONFIG_USB_RISCV_BRIDGE=n

# memory
# os_malloc defaults to PSRAM heap; 8KB SRAM heap kept for early boot
CONFIG_OS_HEAP_USE_PSRAM=y
# stacks/queues in PSRAM; rtos_create_hsram_thread users stay in HSRAM
CONFIG_TASK_STACK_IN_PSRAM=n
CONFIG_QUEUE_IN_PSRAM=n

# disabled
# CONFIG_SECURE_OTA_OVERWRITE is not set
# CONFIG_OTA_FUNCTION is not set
# CONFIG_OTA_HTTP is not set
# CONFIG_ALL_CODE_IN_PSRAM is not set
# CONFIG_OTA_HTTP is not set
# CONFIG_BK_SMART_CONFIG is not set
# CONFIG_ADK_VFS_UTIL is not set
# CONFIG_AE_ENABLE_PA_CNTRL is not set
# CONFIG_UART_RX_DMA is not set
# CONFIG_UART_RX_DMA_KFIFO_SIZE is not set
# CONFIG_AP_SECURE_CACHE_NSC is not set
