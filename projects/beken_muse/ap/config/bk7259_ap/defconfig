# Robot V1 AI kit: on-board SD-NAND (U14 MKDV4GCL-ABB) is wired to
# SDIO controller 1 (P14~P19), and NAND_VDD is gated by P53.
# The Type-C is shared between CH340 (default log/flash UART) and
# BK7259 full-speed USB via a pair of FSW3157A muxes driven by P54.
CONFIG_SDIO_USE_GROUP1=y
CONFIG_SDCARD_HOST_ID=1
CONFIG_SDCARD_BUSWIDTH_4LINE=y
CONFIG_BOARD_SD_NAND_ENABLE=y
CONFIG_BOARD_SD_NAND_POWER_GPIO=53
CONFIG_BOARD_USB_SWITCH_ENABLE=y
CONFIG_BOARD_USB_SWITCH_GPIO=54
CONFIG_BOARD_USB_SWITCH_USB_LEVEL=1
CONFIG_MUSE_GADGET=y
CONFIG_MUSE_GADGET_VOICE=y
# The Muse ws edge (hatch.metaaivm.com) answers the upgrade with HTTP 401
# when the request carries an Origin header, a User-Agent header or a
# ported Host; the peer accepts the strict RFC 6455 header set only.
CONFIG_WEBSOCKET_UPGRADE_MINIMAL_HEADERS=y
# Move mbedtls allocations (TLS contexts/record buffers, PSA crypto) off
# the scarce SRAM heap onto PSRAM; without this a second concurrent TLS
# session (e.g. display.draw_url image fetch beside the Noise link) fails
# mbedtls_ssl_setup with -0x7F00 (ALLOC_FAILED).
CONFIG_MBEDTLS_USE_PSRAM=y

# Volcano speech (streaming ASR + reply TTS). Credentials are runtime-only
# (old console: APP ID + per-service Access Token): set once on the CLI
# (`muse volcappid <id>` / `muse asrkey <key>` / `muse ttskey <key>`,
# persisted to easyflash); do NOT put credentials in this file.
CONFIG_MUSE_ASR_VOLC=y
CONFIG_MUSE_ASR_VOLC_RESOURCE_ID="volc.seedasr.sauc.duration"
CONFIG_MUSE_TTS_VOLC=y
CONFIG_MUSE_TTS_VOLC_RESOURCE_ID="seed-tts-2.0"
CONFIG_MUSE_TTS_VOLC_VOICE="zh_female_xiaohe_uranus_bigtts"
CONFIG_MUSE_TTS_VOLC_OUT_PATH="/sd0/tts_volc.mp3"
