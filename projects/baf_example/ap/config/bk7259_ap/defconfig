#
# Automatically generated project default config. You can update it with menuconfig [D] option.
# This file contains only differences compared to board defconfig.
#
# CONFIG_LWIP is not set
CONFIG_DPU_DRIVER=y
CONFIG_DSI_DRIVER=y
CONFIG_CLI_TASK_STACK_SIZE=1536
CONFIG_BK_DISPLAY=y
CONFIG_MIPI_DSI=y
CONFIG_DPU_FLUSH_TIMER_DEBUG=y
CONFIG_FRAME_BUFFER=y
CONFIG_VG_LITE_GPU=y
CONFIG_VG_LITE_GPU_BASE_ADDRESS=0x4c280000
CONFIG_VG_LITE_GPU_CONTIGUOUS_MEM_SZ=0x20000
CONFIG_VG_LITE_GPU_COMMAND_BUFFER_SIZE=0x2000
# CONFIG_BK_NETIF is not set
CONFIG_BK_PERIPHERAL=y
CONFIG_LCD_DSI=y
CONFIG_LCD_JD9855_MIPI_320x385=y
# CONFIG_WIFI_CLI_DEBUG is not set
# CONFIG_WIFI_VNET_CONTROLLER is not set
# BAF example backend: RAW (bk_baf) by default; switch to LVGL widget via
# CONFIG_BAF_EXAMPLE_MODE_LVGL (which selects CONFIG_LVGL). CONFIG_LVGL is left to
# the mode choice so RAM/flash for LVGL is only spent in LVGL mode.
#CONFIG_BAF_EXAMPLE_MODE_LVGL=y
CONFIG_LVGL_V9=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LVGL_TASK_PRIORITY=4
CONFIG_LVGL_TASK_STACK_SIZE=8192
CONFIG_LVGL_FRAME_BUFFER_NUM=2
CONFIG_LVGL_USE_GPU_ROTATE=y
CONFIG_MEDIA_SERVICE=y
CONFIG_BK_DECODER=y
CONFIG_AVI_PLAYER=y
CONFIG_BK_VIDEO_PLAYER_ENABLE_HW_H264_VIDEO_DECODER=y
# CONFIG_SPI is not set
CONFIG_DMA_LOGIC_CHAN_CNT=16
CONFIG_DMA_LOGIC_CHAN_ID_MIN=0
CONFIG_PSRAM=y
# On-board TF/SD card on SDIO1 + FATFS (listed via the `tf` CLI). USR_GPIO_CFG_EN
# applies usr_gpio_cfg.h so the SDIO1 pins (GPIO14-19) get muxed; power is GPIO53
# (already driven high by robot_board_power_on()).
CONFIG_USR_GPIO_CFG_EN=y
CONFIG_SDCARD=y
CONFIG_SDCARD_HOST_ID=1
CONFIG_SDCARD_BUSWIDTH_4LINE=y
CONFIG_FATFS=y
CONFIG_FATFS_SDCARD=y
CONFIG_XTAL_FREQ=12000000
CONFIG_TIMER_SUPPORT_ID_BITS=63
